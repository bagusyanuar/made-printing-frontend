{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$features/*": ["./src/features/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js",
		"playwright.config.ts"
	]
}
